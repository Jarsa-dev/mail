<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="mail_activity_board.Chatter"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="after">
            <button
                t-if="this.webChatterProps.has_activities"
                class="o-mail-Chatter-listActivity btn btn-secondary text-nowrap"
                type="button"
                t-att-disabled="!this.thread().hasWriteAccess or !this.thread().id"
                t-on-click="this.onClickListActivity"
            >
                <i class="oi me-1" data-icon="format_list_bulleted" />
                <span>View Activities</span>
            </button>
        </xpath>
    </t>
</templates>
